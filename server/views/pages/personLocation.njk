{% extends "../partials/layout.njk" %}
{% from "components/moj-api-error/macro.njk" import mojApiError %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "components/data-freshness-error-banner/macro.njk" import dataFreshnessErrorBanner %}
{% set pageTitle = applicationName + " - Person Location" %}
{% if dateFilterForm.errorSummary and dateFilterForm.errorSummary | length %}
  {% set pageTitle = "Error: " + pageTitle %}
{% endif %}
{% set mainClasses = "app-container govuk-body" %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [
      {
        text: "Cases",
        href: mpopUrl + "/case"
      },
      {
        text: fullName,
        href: mpopUrl + "/case/" + popData.crn
      },
      {
        text: 'Electronic monitoring - GPS data'
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  {% if locationAlert and locationAlert.text %}
    {{ mojApiError({
      text: locationAlert.text,
      attributes: {
        "data-qa": "location-data-error"
      }
    }) }}
  {% endif %}

  {% include "partials/casesHeader.njk" %}
  <div class="location-activity">
    <h1 class="govuk-heading-l govuk-!-margin-bottom-4">
      {{ fullName }}
    </h1>
    <h2 class="govuk-heading-m">{{ locale.title }} </h2>

    {% if isDataFreshnessError %}  
       {{ dataFreshnessErrorBanner({
            text: "The data sync service is currently down"
          })  
        }}
    {% elif dataFreshness.statuses.length > 0 %}
      <p class="govuk-body-m"> 
        {% set date = dataFreshness.statuses[0].latestPosition | date("D MMMM YYYY") %}
        {% set time = dataFreshness.statuses[0].latestPosition | date("HH:mm") %}
        {{ dataFreshnessErrorBanner({
            text: "There is currently a problem connecting to the trail data. The data was last updated on " + date + " at " + time + ". After this time, location data will be missing from the map.
            <br><br>
            The tag is still recording. When the delay is resolved, all trail data will be available to search."
          })  
        }}
      </p>
    {% else %}  
       {% include "partials/dataRecency.njk" %}
    {% endif %}

    <div class="date-time-picker">
      <div class="govuk-grid-row">
        {% include "partials/mapSearchForm.njk" %}
      </div>
    </div>
    {% include "partials/locationMap.njk" %}
    <p class="govuk-body-m">
      <a href="/map-help?returnUrl={{ currentUrl }}">{{ locale.links.mapHelp }}</a>
    </p>
  </div>
{% endblock %}
